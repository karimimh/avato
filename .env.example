# Application
APP_ENV=development
APP_NAME=Avato
LOG_LEVEL=INFO

# Public/local URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8100
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# Optional host port overrides for Docker Compose
FRONTEND_PORT_FORWARD=3000
BACKEND_PORT_FORWARD=8100
NGINX_PORT_FORWARD=8080
POSTGRES_PORT_FORWARD=5432
REDIS_PORT_FORWARD=6379
MINIO_API_PORT_FORWARD=9100
MINIO_CONSOLE_PORT_FORWARD=9101

# PostgreSQL
POSTGRES_DB=avato
POSTGRES_USER=avato
POSTGRES_PASSWORD=avato-dev-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://avato:avato-dev-password@postgres:5432/avato

# Redis and Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# S3-compatible object storage (local defaults target MinIO)
S3_ENDPOINT_URL=http://minio:9000
# URL embedded in signed links returned to the browser. In production this
# should be the public HTTPS origin of the S3-compatible service.
S3_PUBLIC_ENDPOINT_URL=http://localhost:9100
S3_REGION=us-east-1
S3_BUCKET=avato-local
S3_ACCESS_KEY_ID=avato-local
S3_SECRET_ACCESS_KEY=avato-local-password
S3_USE_SSL=false
# Set to AES256 for providers with server-side encryption enabled. Local MinIO
# intentionally leaves this blank unless KMS/SSE is configured.
S3_SERVER_SIDE_ENCRYPTION=
MINIO_ROOT_USER=avato-local
MINIO_ROOT_PASSWORD=avato-local-password

# Reserved for a future external AI provider; intentionally unused
OPENAI_API_KEY=

# Local speech-to-text model. `small` is the production-quality default;
# `tiny` is useful for fast smoke tests.
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Optional; avoids anonymous Hugging Face download rate limits.
HF_TOKEN=

# Payment. `local` is deterministic and moves no money. For production set
# PAYMENT_PROVIDER=zarinpal and configure the merchant ID/callback HTTPS URL.
PAYMENT_PROVIDER=local
PAYMENT_CALLBACK_URL=http://localhost:8080/api/payments/callback
PAYMENT_LOCAL_SECRET=local-payment-secret-change-me
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
